# =============================================================================
# .gitignore for Semantic Caching & Cost-Aware Routing RAG System
# =============================================================================

# --- Secrets and Environment Files (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# --- Python Build & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Vector Database & Cache Persistence (Local Data) ---
faiss_index/
cache_data/
chroma_db/
test_chroma_db/
postgres_data/

# --- Uploaded PDFs & Large Binary Assets ---
data/pdfs/*.pdf
!data/pdfs/rag_architecture_handbook.pdf
!data/pdfs/sample_rag_guide.pdf

# --- Testing & Coverage Artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
.directory

# --- Temporary/Scratch Files ---
extract_step477.py
stage5_prompt.txt

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
