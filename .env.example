# =============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Model Credentials & Names
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002

# -----------------------------------------------------------------------------
# 2. Vector Database Configuration
# -----------------------------------------------------------------------------
# Backend selector: 'faiss' (default in-memory/disk) or 'pgvector' (production PostgreSQL)
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_DIR=./faiss_index
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# PostgreSQL + pgvector connection string (used when VECTOR_STORE_BACKEND=pgvector)
POSTGRES_CONNECTION_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# -----------------------------------------------------------------------------
# 3. RAG Retrieval & Chunking Parameters
# -----------------------------------------------------------------------------
TOP_K_RESULTS=4
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# -----------------------------------------------------------------------------
# 4. Semantic Caching (Stage 3)
# -----------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=true
SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=86400
CACHE_PERSIST_DIR=./cache_data

# -----------------------------------------------------------------------------
# 5. Cost-Aware LLM Router (Stage 4)
# -----------------------------------------------------------------------------
LLM_ROUTING_ENABLED=true
LLM_MODEL_SIMPLE=gpt-3.5-turbo
LLM_MODEL_COMPLEX=gpt-4o-mini
ROUTING_THRESHOLD=0.45

# Token Cost Tracking (USD per 1,000 tokens)
COST_PER_1K_INPUT_TOKENS=0.0005
COST_PER_1K_OUTPUT_TOKENS=0.0015

# -----------------------------------------------------------------------------
# 6. Advanced Retrieval & Multi-Turn Intelligence (Stage 6)
# -----------------------------------------------------------------------------
# Hybrid Retrieval: FAISS dense vector search + BM25 sparse keyword search via RRF
HYBRID_SEARCH_ENABLED=true
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
RRF_K=60

# Conversational query rewriting for follow-ups
QUERY_REWRITING_ENABLED=true

# Automated LLM-as-a-Judge evaluation model
LLM_JUDGE_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 7. Production Security & Rate Limiting (Stage 7)
# -----------------------------------------------------------------------------
# Enable/disable X-API-Key header verification (false for local dev, true in prod)
API_KEY_AUTH_ENABLED=false
API_AUTH_KEY=your-secret-client-api-key-here

# Sliding-window rate limiter per client IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
